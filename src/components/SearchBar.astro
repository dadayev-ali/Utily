---
import { categoryMeta } from "../data/tools";
import type { ToolCategory } from "../data/tools";

const categories = Object.keys(categoryMeta) as ToolCategory[];
---

<style>
  .search-input:focus {
    outline: none;
    box-shadow: none;
    border-color: var(--color-primary-container);
  }
  #chips-scroll-container {
    scrollbar-width: none;
    -ms-overflow-style: none;
    cursor: grab;
  }
  #chips-scroll-container::-webkit-scrollbar {
    display: none;
  }
  #chips-scroll-container.dragging {
    cursor: grabbing;
    user-select: none;
  }
</style>

<div class="w-full mb-4 mt-8 sm:mt-10 md:mt-12">
  <!-- Search input + Clear All -->
  <div class="flex items-stretch gap-2 sm:gap-4 w-full">
    <div class="relative flex items-center group flex-1">
      <span
        class="material-symbols-outlined absolute left-3 sm:left-4 text-on-surface-variant group-focus-within:text-primary-container transition-colors text-xl sm:text-2xl"
      >
        search
      </span>
      <input
        id="tool-search"
        class="search-input w-full h-full pl-10 sm:pl-12 pr-4 py-3 sm:py-4 bg-surface-container-low border border-outline-variant rounded-full font-body text-sm sm:text-base text-on-surface placeholder:text-on-surface-variant/60 transition-all"
        placeholder="Search for a tool (e.g., GPA, Currency)..."
        type="text"
      />
    </div>
    <button
      id="clear-all-btn"
      class="shrink-0 flex items-center justify-center gap-1.5 px-3 sm:px-6 rounded-full border border-outline-variant bg-surface-container-low text-on-surface-variant text-[11px] font-bold uppercase tracking-wider transition-all duration-200 hover:border-error/50 hover:text-error cursor-pointer whitespace-nowrap"
      aria-label="Clear all filters"
    >
      <span class="material-symbols-outlined text-sm leading-none">close</span>
      <span class="hidden sm:inline">Clear options</span>
    </button>
  </div>

  <!-- Pinned filter + Category chips -->
  <div class="flex flex-col sm:flex-row sm:items-center gap-3 mt-4 ml-1">
    <!-- Pinned toggle -->
    <div class="flex items-center gap-3 shrink-0">
      <div
        id="pinned-filter-btn"
        role="switch"
        aria-checked="false"
        style="position:relative; display:inline-block; width:44px; height:24px; border-radius:12px; background-color:#424752; cursor:pointer; flex-shrink:0; transition:background-color 200ms ease;"
      >
        <div
          id="pinned-filter-thumb"
          style="position:absolute; top:3px; left:3px; width:18px; height:18px; border-radius:50%; background-color:#f8f9fb; transition:transform 200ms ease;"
        >
        </div>
      </div>
      <label
        class="flex items-center gap-1.5 text-xs font-bold uppercase tracking-widest text-on-surface-variant cursor-pointer select-none whitespace-nowrap"
        id="pinned-filter-label"
      >
        <span
          class="material-symbols-outlined text-base leading-none"
          id="pinned-filter-icon">keep</span
        >
        Show pinned only
      </label>
    </div>

    <!-- Divider -->
    <div class="hidden sm:block w-px h-5 bg-outline-variant/40 shrink-0"></div>

    <!-- Category chips — drag-scrollable -->
    <div id="chips-scroll-container" class="flex-1 overflow-x-auto">
      <div class="flex items-center gap-2 w-max" id="category-chips">
        {
          categories.map((cat) => (
            <button
              class="category-chip flex items-center gap-1.5 px-3 py-1.5 rounded-full border border-outline-variant/50 bg-surface-container-low text-on-surface-variant text-[11px] font-bold uppercase tracking-wider transition-all duration-200 cursor-pointer hover:border-primary/50 hover:text-primary select-none whitespace-nowrap"
              data-category={cat}
            >
              <span class="material-symbols-outlined text-sm leading-none">
                {categoryMeta[cat].icon}
              </span>
              {categoryMeta[cat].label}
            </button>
          ))
        }
      </div>
    </div>
  </div>
</div>

<hr class="border-none h-px bg-outline-variant/30 mb-8" />

<script>
  const STORAGE_KEY = "utily_pinned_tools";

  function getPinned(): string[] {
    try {
      return JSON.parse(localStorage.getItem(STORAGE_KEY) || "[]");
    } catch {
      return [];
    }
  }

  const input = document.getElementById("tool-search") as HTMLInputElement;
  const clearAllBtn = document.getElementById("clear-all-btn") as HTMLElement;
  const filterBtn = document.getElementById("pinned-filter-btn") as HTMLElement;
  const filterThumb = document.getElementById(
    "pinned-filter-thumb",
  ) as HTMLElement;
  const filterIcon = document.getElementById(
    "pinned-filter-icon",
  ) as HTMLElement;
  const filterLabel = document.getElementById(
    "pinned-filter-label",
  ) as HTMLElement;
  const noResults = document.getElementById("no-results")!;
  const categoryChips =
    document.querySelectorAll<HTMLElement>(".category-chip");
  const chipsScroll = document.getElementById(
    "chips-scroll-container",
  ) as HTMLElement;

  let showPinnedOnly = false;
  const selectedCategories = new Set<string>();

  // ── Drag-to-scroll ────────────────────────────────────────────────────────────
  let isDragging = false;
  let dragStartX = 0;
  let scrollStart = 0;
  let hasDragged = false;

  chipsScroll.addEventListener("mousedown", (e) => {
    isDragging = true;
    hasDragged = false;
    dragStartX = e.pageX - chipsScroll.offsetLeft;
    scrollStart = chipsScroll.scrollLeft;
    chipsScroll.classList.add("dragging");
  });

  window.addEventListener("mouseup", () => {
    isDragging = false;
    chipsScroll.classList.remove("dragging");
  });

  window.addEventListener("mousemove", (e) => {
    if (!isDragging) return;
    e.preventDefault();
    const x = e.pageX - chipsScroll.offsetLeft;
    const walk = x - dragStartX;
    if (Math.abs(walk) > 4) hasDragged = true;
    chipsScroll.scrollLeft = scrollStart - walk;
  });

  chipsScroll.addEventListener(
    "click",
    (e) => {
      if (hasDragged) {
        e.stopPropagation();
        hasDragged = false;
      }
    },
    true,
  );

  // ── Filter logic ──────────────────────────────────────────────────────────────
  function applyFilters() {
    const query = input.value.trim().toLowerCase();
    const pinned = getPinned();
    const cards = document.querySelectorAll<HTMLElement>(".tool-card");
    let visible = 0;

    cards.forEach((card) => {
      const title = card.dataset.title ?? "";
      const id = card.dataset.toolId ?? "";
      const category = card.dataset.category ?? "";
      const show =
        title.includes(query) &&
        (!showPinnedOnly || pinned.includes(id)) &&
        (selectedCategories.size === 0 || selectedCategories.has(category));
      card.style.display = show ? "" : "none";
      if (show) visible++;
    });

    noResults.classList.toggle("hidden", visible !== 0);
    noResults.classList.toggle("flex", visible === 0);
  }

  function setChipActive(chip: HTMLElement, active: boolean) {
    if (active) {
      chip.classList.add("bg-primary", "text-on-primary", "border-primary");
      chip.classList.remove(
        "bg-surface-container-low",
        "text-on-surface-variant",
        "border-outline-variant/50",
        "hover:border-primary/50",
        "hover:text-primary",
      );
    } else {
      chip.classList.remove("bg-primary", "text-on-primary", "border-primary");
      chip.classList.add(
        "bg-surface-container-low",
        "text-on-surface-variant",
        "border-outline-variant/50",
        "hover:border-primary/50",
        "hover:text-primary",
      );
    }
  }

  categoryChips.forEach((chip) => {
    chip.addEventListener("click", () => {
      const cat = chip.dataset.category!;
      if (selectedCategories.has(cat)) {
        selectedCategories.delete(cat);
        setChipActive(chip, false);
      } else {
        selectedCategories.add(cat);
        setChipActive(chip, true);
      }
      applyFilters();
    });
  });

  filterBtn.addEventListener("click", () => {
    showPinnedOnly = !showPinnedOnly;
    filterBtn.setAttribute("aria-checked", String(showPinnedOnly));
    if (showPinnedOnly) {
      filterBtn.style.backgroundColor = "#00478d";
      filterThumb.style.transform = "translateX(20px)";
      filterIcon.style.fontVariationSettings =
        "'FILL' 1, 'wght' 500, 'GRAD' 0, 'opsz' 24";
      filterLabel.classList.replace("text-on-surface-variant", "text-primary");
    } else {
      filterBtn.style.backgroundColor = "#424752";
      filterThumb.style.transform = "translateX(0px)";
      filterIcon.style.fontVariationSettings =
        "'FILL' 0, 'wght' 400, 'GRAD' 0, 'opsz' 24";
      filterLabel.classList.replace("text-primary", "text-on-surface-variant");
    }
    applyFilters();
  });

  function resetPinnedToggle() {
    showPinnedOnly = false;
    filterBtn.setAttribute("aria-checked", "false");
    filterBtn.style.backgroundColor = "#424752";
    filterThumb.style.transform = "translateX(0px)";
    filterIcon.style.fontVariationSettings =
      "'FILL' 0, 'wght' 400, 'GRAD' 0, 'opsz' 24";
    filterLabel.classList.replace("text-primary", "text-on-surface-variant");
  }

  clearAllBtn.addEventListener("click", () => {
    input.value = "";
    resetPinnedToggle();
    selectedCategories.clear();
    categoryChips.forEach((chip) => setChipActive(chip, false));
    applyFilters();
  });

  filterLabel.addEventListener("click", () => filterBtn.click());
  window.addEventListener("pinstate:changed", applyFilters);
  input.addEventListener("input", () => {
    applyFilters();
  });
</script>
