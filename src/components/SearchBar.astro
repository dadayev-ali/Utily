---

<style>
  .search-input:focus {
    outline: none;
    box-shadow: none;
    border-color: var(--color-primary-container);
  }
</style>

<div class="w-full max-w-3xl mb-10 sm:mb-14 md:mb-16 mt-8 sm:mt-10 md:mt-12">
  <div class="relative flex items-center group">
    <span
      class="material-symbols-outlined absolute left-3 sm:left-4 text-on-surface-variant group-focus-within:text-[var(--color-primary-container)] transition-colors text-xl sm:text-2xl"
    >
      search
    </span>
    <input
      class="search-input w-full pl-10 sm:pl-12 pr-4 py-3 sm:py-4 bg-surface-container-low border border-outline-variant rounded-[12px] font-body text-sm sm:text-base text-on-surface placeholder:text-on-surface-variant/60 transition-all"
      placeholder="Search for a tool (e.g., GPA, Currency)..."
      type="text"
    />
  </div>
</div>
