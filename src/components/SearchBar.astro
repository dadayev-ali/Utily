---

---

<style>
  .search-input:focus {
    outline: none;
    box-shadow: none;
    border-color: var(--color-primary-container);
  }
</style>

<div class="w-full max-w-3xl mb-4 mt-8 sm:mt-10 md:mt-12">
  <!-- Search input -->
  <div class="relative flex items-center group">
    <span
      class="material-symbols-outlined absolute left-3 sm:left-4 text-on-surface-variant group-focus-within:text-primary-container transition-colors text-xl sm:text-2xl"
    >
      search
    </span>
    <input
      id="tool-search"
      class="search-input w-full pl-10 sm:pl-12 pr-4 py-3 sm:py-4 bg-surface-container-low border border-outline-variant rounded-full font-body text-sm sm:text-base text-on-surface placeholder:text-on-surface-variant/60 transition-all"
      placeholder="Search for a tool (e.g., GPA, Currency)..."
      type="text"
    />
  </div>

  <!-- Pinned filter toggle -->
  <div class="flex items-center gap-3 mt-4 ml-1">
    <div
      id="pinned-filter-btn"
      role="switch"
      aria-checked="false"
      style="position:relative; display:inline-block; width:44px; height:24px; border-radius:12px; background-color:#424752; cursor:pointer; flex-shrink:0; transition:background-color 200ms ease;"
    >
      <div
        id="pinned-filter-thumb"
        style="position:absolute; top:3px; left:3px; width:18px; height:18px; border-radius:50%; background-color:#f8f9fb; transition:transform 200ms ease;"
      >
      </div>
    </div>
    <label
      class="flex items-center gap-1.5 text-xs font-bold uppercase tracking-widest text-on-surface-variant cursor-pointer select-none"
      id="pinned-filter-label"
    >
      <span
        class="material-symbols-outlined text-base leading-none"
        id="pinned-filter-icon">keep</span
      >
      Show pinned only
    </label>
  </div>
</div>

<hr class="border-none h-px bg-outline-variant/30 mb-8" />

<script>
  const STORAGE_KEY = "utily_pinned_tools";

  function getPinned(): string[] {
    try {
      return JSON.parse(localStorage.getItem(STORAGE_KEY) || "[]");
    } catch {
      return [];
    }
  }

  const input = document.getElementById("tool-search") as HTMLInputElement;
  const filterBtn = document.getElementById("pinned-filter-btn") as HTMLElement;
  const filterThumb = document.getElementById(
    "pinned-filter-thumb",
  ) as HTMLElement;
  const filterIcon = document.getElementById(
    "pinned-filter-icon",
  ) as HTMLElement;
  const filterLabel = document.getElementById(
    "pinned-filter-label",
  ) as HTMLElement;
  const noResults = document.getElementById("no-results")!;

  let showPinnedOnly = false;

  function applyFilters() {
    const query = input.value.trim().toLowerCase();
    const pinned = getPinned();
    const cards = document.querySelectorAll<HTMLElement>(".tool-card");
    let visible = 0;

    cards.forEach((card) => {
      const title = card.dataset.title ?? "";
      const id = card.dataset.toolId ?? "";
      const matchesQuery = title.includes(query);
      const matchesPinned = !showPinnedOnly || pinned.includes(id);
      const show = matchesQuery && matchesPinned;
      card.style.display = show ? "" : "none";
      if (show) visible++;
    });

    const hasNoResults = visible === 0;
    noResults.classList.toggle("hidden", !hasNoResults);
    noResults.classList.toggle("flex", hasNoResults);
  }

  filterBtn.addEventListener("click", () => {
    showPinnedOnly = !showPinnedOnly;
    filterBtn.setAttribute("aria-checked", String(showPinnedOnly));

    if (showPinnedOnly) {
      filterBtn.style.backgroundColor = "#00478d";
      filterThumb.style.transform = "translateX(20px)";
      filterIcon.style.fontVariationSettings =
        "'FILL' 1, 'wght' 500, 'GRAD' 0, 'opsz' 24";
      filterLabel.classList.replace("text-on-surface-variant", "text-primary");
    } else {
      filterBtn.style.backgroundColor = "#424752";
      filterThumb.style.transform = "translateX(0px)";
      filterIcon.style.fontVariationSettings =
        "'FILL' 0, 'wght' 400, 'GRAD' 0, 'opsz' 24";
      filterLabel.classList.replace("text-primary", "text-on-surface-variant");
    }

    applyFilters();
  });

  // Clicking the label also toggles
  filterLabel.addEventListener("click", () => filterBtn.click());

  // Re-run filters whenever pin state changes (pin/unpin from cards)
  window.addEventListener("pinstate:changed", applyFilters);

  input.addEventListener("input", applyFilters);
</script>
