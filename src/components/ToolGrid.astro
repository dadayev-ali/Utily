---
import ToolCard from "./ToolCard.astro";
import { tools } from "../data/tools";
---

<div
  class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4 gap-8"
  id="tool-grid"
>
  {tools.map((tool) => <ToolCard {...tool} />)}
</div>

<p id="no-results" class="hidden text-center text-on-surface-variant text-base sm:text-lg mt-8">
  No tools found for your search.
</p>
