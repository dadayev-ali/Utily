---
import Container from "./Container.astro";
---

<footer class="w-full border-t border-outline-variant/15 bg-surface">
  <Container>
    <div
      class="flex flex-col md:flex-row justify-between items-center py-8 md:py-12 gap-6 md:gap-0 text-center md:text-left"
    >
      <div class="mb-0">
        <span class="font-bold text-on-surface block mb-2">Utily</span>
        <p
          class="text-[0.7rem] sm:text-[0.75rem] uppercase tracking-wider text-on-surface-variant"
        >
          © 2026 Utily. Where precision meets simplicity.
        </p>
      </div>
      <div class="flex flex-wrap justify-center md:justify-end gap-4 sm:gap-6">
        <a
          class="text-[0.7rem] sm:text-[0.75rem] uppercase tracking-wider text-on-surface-variant hover:text-primary transition-colors"
          href="#">Privacy Policy</a
        >
        <a
          class="text-[0.7rem] sm:text-[0.75rem] uppercase tracking-wider text-on-surface-variant hover:text-primary transition-colors"
          href="#">Terms of Service</a
        >
        <a
          class="text-[0.7rem] sm:text-[0.75rem] uppercase tracking-wider text-on-surface-variant hover:text-primary transition-colors"
          href="#">Support</a
        >
      </div>
    </div>
  </Container>
</footer>
