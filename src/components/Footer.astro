---
import Container from "./Container.astro";
---

<footer class="w-full border-t border-outline-variant/15 bg-surface">
  <Container>
    <div
      class="flex flex-col md:flex-row justify-between items-center py-8 md:py-12 gap-6 md:gap-0 text-center md:text-left"
    >
      <span class="font-bold text-on-surface">Utily</span>
      <p
        class="text-[0.7rem] sm:text-[0.75rem] uppercase tracking-wider text-on-surface-variant"
      >
        © 2026 Utily. Where precision meets simplicity.
      </p>
    </div>
  </Container>
</footer>
