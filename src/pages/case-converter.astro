---
import Layout from "../layouts/Layout.astro";
import Container from "../components/Container.astro";
import CaseConverter from "../components/CaseConverter";
---

<Layout title="Case Converter | Utily">
  <!-- Floating Back to Home -->
  <div
    id="floating-back-wrapper"
    class="sticky top-18 lg:top-24 z-40 h-0 overflow-visible opacity-0 -translate-y-2 transition-all duration-300 pointer-events-none"
  >
    <Container>
      <a
        href="/"
        class="pointer-events-auto inline-flex items-center gap-2 px-4 py-2 bg-surface-container border border-outline-variant/30 rounded-full text-on-surface-variant hover:text-primary hover:border-primary text-xs font-bold uppercase tracking-widest shadow-md transition-colors duration-200"
      >
        <span class="material-symbols-outlined text-base">arrow_back</span>
        Back
      </a>
    </Container>
  </div>

  <main>
    <Container class="py-12">
      <!-- Header -->
      <div class="flex flex-col items-center max-w-4xl mx-auto text-center mb-16">
        <div class="mb-8" id="back-home-anchor">
          <a
            class="flex items-center gap-2 text-on-surface-variant hover:text-primary transition-colors text-xs font-bold uppercase tracking-widest"
            href="/"
          >
            <span class="material-symbols-outlined text-lg">arrow_back</span>
            Back to Home
          </a>
        </div>
        <h1
          class="text-4xl md:text-5xl font-extrabold tracking-tight font-headline text-on-surface leading-tight mb-4"
        >
          Case <span class="text-primary">Converter</span>
        </h1>
        <p class="text-on-surface-variant text-base leading-relaxed max-w-xl">
          A precision instrument for text transformation. Efficiently modify string cases for documentation, code consistency, or publication standards.
        </p>
      </div>

      <!-- Tool Canvas — powered by React -->
      <div class="max-w-7xl mx-auto w-full mb-16">
        <CaseConverter client:only="react" />
      </div>
    </Container>
  </main>
</Layout>

<script is:inline>
  const floatingBack = document.getElementById("floating-back-wrapper");
  const anchor = document.getElementById("back-home-anchor");
  new IntersectionObserver(([entry]) => {
    if (!entry.isIntersecting) {
      floatingBack.classList.remove("opacity-0", "-translate-y-2");
      floatingBack.classList.add("opacity-100", "translate-y-0");
    } else {
      floatingBack.classList.add("opacity-0", "-translate-y-2");
      floatingBack.classList.remove("opacity-100", "translate-y-0");
    }
  }).observe(anchor);
</script>
